{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",           // Change from "commonjs" to "node16"
    "moduleResolution": "node16", // Keep this as "node16"
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}